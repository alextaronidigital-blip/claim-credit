#!/bin/bash
# ---------------------------------------------------------------
#  YDG · Hub Ospitalita
#  Mette sulla Scrivania un'icona vera e propria per l'hub.
#  A differenza del collegamento .webloc, questa non perde mai
#  l'icona: fa parte dell'applicazione stessa.
#
#  Uso: doppio clic. Se il Mac dice che non e' di uno sviluppatore
#  identificato -> clic destro sul file -> Apri -> Apri.
# ---------------------------------------------------------------
set -e

URL="https://claude.ai/artifact/JxVvByJ51pHWdQrufWt4g4"
NOME="Benchmark Hotel YDG"
APP="$HOME/Desktop/$NOME.app"

printf "\n\033[1mYDG · installazione icona hub\033[0m\n\n"

rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"

cat > "$APP/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Benchmark Hotel YDG</string>
  <key>CFBundleDisplayName</key><string>Benchmark Hotel YDG</string>
  <key>CFBundleIdentifier</key><string>studio.ydg.hub.ospitalita</string>
  <key>CFBundleVersion</key><string>1.0</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundleExecutable</key><string>avvia</string>
  <key>CFBundleIconFile</key><string>YDG</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>LSUIElement</key><true/>
</dict>
</plist>
PLIST

cat > "$APP/Contents/MacOS/avvia" <<AVVIA
#!/bin/sh
exec open "$URL"
AVVIA
chmod +x "$APP/Contents/MacOS/avvia"

B64="$(mktemp)"
cat > "$B64" <<'ICNS'
