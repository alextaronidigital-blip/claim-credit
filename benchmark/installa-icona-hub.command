QgghhBBCCCGEEEIIIYQQQgghhBBCCNk6/n+xQxy4+3os4AAAAABJRU5ErkJggg==
ICNS

if openssl base64 -d -in "$B64" -out "$APP/Contents/Resources/YDG.icns" 2>/dev/null; then
  :
elif base64 -D -i "$B64" -o "$APP/Contents/Resources/YDG.icns" 2>/dev/null; then
  :
else
  base64 -d < "$B64" > "$APP/Contents/Resources/YDG.icns"
fi
rm -f "$B64"

if [ ! -s "$APP/Contents/Resources/YDG.icns" ]; then
  printf "\033[31m✗\033[0m Non sono riuscito a scrivere l'icona. Mandami questo messaggio.\n"
  read -n 1 -s -r -p "Premi un tasto per chiudere."; exit 1
fi

xattr -cr "$APP" 2>/dev/null || true
touch "$APP"

printf "\033[32m✓\033[0m Icona installata: %s\n" "$APP"
printf "\033[33m→\033[0m Se la vedi ancora generica, premi Cmd+Opzione+Esc, scegli Finder e \"Riavvia\".\n"
printf "\n   Il vecchio collegamento \"Benchmark Hotel YDG.webloc\" sulla Scrivania,\n"
printf "   se c'e' ancora, puoi buttarlo: questa app lo sostituisce.\n\n"
read -n 1 -s -r -p "Premi un tasto per chiudere."
echo
